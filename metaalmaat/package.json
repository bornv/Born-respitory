{
  "name": "metaalmaat",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "desktop": "electron .",
    "build:windows": "electron-builder --win nsis --x64",
    "test:windows": "node scripts/smoke-test.cjs",
    "build:portable": "electron-builder --win portable --x64",
    "test:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-setup.ps1"
  },
  "version": "2.1.1",
  "description": "JBT Marel Materiaalprijs Converter — metaalprijzen en eenheden omrekenen",
  "author": "JBT Marel",
  "main": "desktop/main.cjs",
  "build": {
    "appId": "nl.metaalmaat.desktop",
    "productName": "Materiaalprijs Converter",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "desktop/icon.png",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "Materiaalprijs-Converter-${version}-Windows.exe",
      "requestExecutionLevel": "user",
      "useZip": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "selectPerMachineByDefault": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "menuCategory": "JBT Marel",
      "shortcutName": "Materiaalprijs Converter",
      "uninstallDisplayName": "JBT Marel Materiaalprijs Converter",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "installerLanguages": [
        "nl_NL",
        "en_US"
      ],
      "language": "1043",
      "artifactName": "Materiaalprijs-Converter-Setup-${version}-x64.exe"
    },
    "extraFiles": [
      {
        "from": "LEESMIJ-WINDOWS.txt",
        "to": "LEESMIJ-WINDOWS.txt"
      },
      {
        "from": "dist/Materiaalprijs-Converter-invulformat.xlsx",
        "to": "Materiaalprijs-Converter-invulformat.xlsx"
      }
    ]
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.15.3",
    "jszip": "^3.10.1",
    "playwright-core": "1.62.1"
  }
}
