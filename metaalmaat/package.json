{
  "name": "metaalmaat",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "desktop": "electron .",
    "build:windows": "electron-builder --win portable --x64",
    "test:windows": "node scripts/smoke-test.cjs"
  },
  "version": "2.0.1",
  "description": "JBT Marel Materiaalprijs Converter — metaalprijzen en eenheden omrekenen",
  "author": "JBT Marel",
  "main": "desktop/main.cjs",
  "build": {
    "appId": "nl.metaalmaat.desktop",
    "productName": "Materiaalprijs Converter",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "desktop/icon.png",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "Materiaalprijs-Converter-${version}-Windows.exe",
      "requestExecutionLevel": "user",
      "useZip": true
    }
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.15.3",
    "jszip": "^3.10.1",
    "playwright-core": "1.62.1"
  }
}
